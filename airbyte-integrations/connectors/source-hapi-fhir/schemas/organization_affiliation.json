{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": ["lastUpdated", "source", "versionId"]
    },
    "identifier": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "use": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": ["use", "value"]
      }
    },
    "active": {
      "type": "boolean"
    },
    "organization": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      },
      "required": ["display", "reference"]
    },
    "location": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "display": {
            "type": "string"
          }
        },
        "required": ["display", "reference"]
      }
    }
  },
  "required": [
    "active",
    "id",
    "identifier",
    "location",
    "meta",
    "organization",
    "resourceType"
  ]
}
